# Supabase (obligatorio)
VITE_SUPABASE_URL=TU_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# Stripe (obligatorio para pagos)
VITE_STRIPE_PUBLISHABLE_KEY=TU_STRIPE_PUBLISHABLE_KEY

# Google Maps (obligatorio para mapa y direcciones)
VITE_GOOGLE_MAPS_API_KEY=TU_GOOGLE_MAPS_API_KEY

# Deep links (opcional). Con "1" aparece el boton "Abrir en la app" en el
# banner de la tienda publica, que lleva a ESE restaurante dentro de la app.
# DEJARLO APAGADO hasta que las builds con el esquema com.pidoo.app://r/<slug>
# esten publicadas en Play y App Store: las versiones instaladas hoy no lo
# entienden y el boton mandaria a la tienda de apps a quien ya tiene la app.
# La pagina puente /abrir/<slug> funciona siempre, encendido o apagado.
VITE_DEEP_LINKS_ACTIVOS=0

# Firebase Cloud Messaging (obligatorio para push notifications)
VITE_FIREBASE_API_KEY=TU_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=TU_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=TU_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=TU_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=TU_FIREBASE_APP_ID
VITE_FIREBASE_VAPID_KEY=TU_FIREBASE_VAPID_KEY
